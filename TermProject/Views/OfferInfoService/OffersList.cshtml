@model List<TermProject.Models.AgentOffers>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Agent Offer List</title>
    <!-- Ensure Bootstrap CSS is included -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light text-dark">
    <div class="container my-4">
        <h2 class="mb-4">Offer List for Agent</h2>
        <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Home Address</th>
                    <th>Home City</th>
                    <th>Home State</th>
                    <th>Home ZipCode</th>
                    <th>Home Price</th>
                    <th>Property Type</th>
                    <th>Customer First Name</th>
                    <th>Customer Last Name</th>
                    <th>Customer Email</th>
                    <th>Customer Phone Number</th>
                    <th>Offer Price</th>
                    <th>Sale Type</th>
                    <th>Move-in Date</th>
                    <th>Contingencies</th>
                    <th>Need to Sell Their Home?</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (AgentOffers offer in Model)
                {
                    <tr>
                        <td>@offer.Home.Address</td>
                        <td>@offer.Home.City</td>
                        <td>@offer.Home.State</td>
                        <td>@offer.Home.Zipcode</td>
                        <td>@offer.Home.HomePrice</td>
                        <td>@offer.Home.PropType</td>
                        <td>@offer.CustomerOffer.CustFirstName</td>
                        <td>@offer.CustomerOffer.CustLastName</td>
                        <td>@offer.CustomerOffer.CustEmail</td>
                        <td>@offer.CustomerOffer.CustPhoneNum</td>
                        <td>@offer.CustomerOffer.OfferAmount</td>
                        <td>@offer.CustomerOffer.SaleType</td>
                        <td>@offer.CustomerOffer.MoveInDate</td>
                        <td>@offer.CustomerOffer.Contigencies</td>
                        <td>@offer.CustomerOffer.CustHomeStatus</td>
                        
                        <td>
                            <div class="d-inline-block">
                                    <form  asp-controller="OfferInfoService" asp-action="DeleteOffer" method="post" class="d-inline">
                                    <input type="hidden" name="offerID" value="@offer.CustomerOffer.OfferID" />
                                    <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                                </form>
                                <form asp-action="" method="get" class="d-inline">
                                    <input type="hidden" name="homeId" value="@offer.Agent.AgentID" />
                                    <button type="submit" class="btn btn-primary btn-sm ms-2">Accept</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            
        </table>

        <div class="d-flex justify-content-center mt-4">
            <a asp-controller="Account" asp-action="Portal" class="btn btn-secondary">Back</a>
        </div>
    </div>
    </div>
  
</body>
</html>
