@{
    // ViewData["Title"] = "Home Page";
}
@addTagHelper *,  Microsoft.AspNetCore.Mvc.TagHelpers
@model List<TermProject.Models.HomeInfo>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Haven Realty Homes</title>
    <link rel="stylesheet" href="~/css/AllHome.css" />

    <!-- Include Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light text-dark">
    <header class="text-center my-4">
        <h1 class="display-4">Haven Realty Homes</h1>
    </header>

    <div class="container my-4">
        <!-- Search/Filter Form -->
        <form asp-action="Filter" method="post" class="mb-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="state" class="form-label">Select State:</label>
                    <select id="state" name="state" class="form-select">
                        <option value="">-- Select an Option --</option>
                        @foreach (var option in (List<string>)ViewBag.State)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="minPrice" class="form-label">Select Minimum Price:</label>
                    <select id="minPrice" name="minPrice" class="form-select">
                        <option value="">-- Select Min Price --</option>
                        @foreach (var option in (Dictionary<string, double>)ViewBag.MinPrice)
                        {
                            <option value="@option.Value">@option.Key</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="maxPrice" class="form-label">Select Maximum Price:</label>
                    <select id="maxPrice" name="maxPrice" class="form-select">
                        <option value="">-- Select Max Price --</option>
                        @foreach (var option in (Dictionary<string, double>)ViewBag.MaxPrice)
                        {
                            <option value="@option.Value">@option.Key</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="propType" class="form-label">Select Property Type:</label>
                    <select id="propType" name="propType" class="form-select">
                        <option value="">-- Select an Option --</option>
                        @foreach (var option in (List<string>)ViewBag.PropType)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="minBaths" class="form-label">Minimum Bathrooms:</label>
                    <select id="minBaths" name="minBaths" class="form-select">
                        <option value="Any">Any</option>
                        @foreach (var bathOption in (List<string>)ViewBag.MinBath)
                        {
                            <option value="@bathOption">@bathOption</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="minBeds" class="form-label">Minimum Bedrooms:</label>
                    <select id="minBeds" name="minBeds" class="form-select">
                        <option value="Any">Any</option>
                        @foreach (var bedOption in (List<string>)ViewBag.MinBed)
                        {
                            <option value="@bedOption">@bedOption</option>
                        }
                    </select>
                </div>

                <div class="col-md-12 d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Filter</button>
                </div>
            </div>
        </form>
    </div>

    <div class="container mb-5">
        <div class="row g-4">
            @foreach (HomeInfo home in Model)
            {
                <div class="col-md-4">
                    <div class="card text-center  text-white h-100">
                        <img src="~/images/house.jpg" class="card-img-top img-fluid" alt="House Image">
                        <div class="card-body">
                            <h5 class="card-title">$@home.HomePrice</h5>
                            <p class="card-text">@home.Address, @home.City, @home.State, @home.Zipcode</p>

                            <p class="card-text"><strong>Bedrooms:</strong> @home.GetNumBedrooms()</p>
                            <p class="card-text"><strong>Bathrooms:</strong> @home.GetNumBathrooms()</p>

                            <a class="btn btn-light mt-2"
                               asp-controller="HomeDisplay"
                               asp-action="HomeDetail"
                               asp-route-homeID="@home.HomeID">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>