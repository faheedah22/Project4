@{
    // ViewData["Title"] = "Home Page";
}
@addTagHelper *,  Microsoft.AspNetCore.Mvc.TagHelpers
@model TermProject.Models.HomeInfo


<div class="text-center">
    <h1 class="display-4">Home Detail</h1>

</div>
<!DOCTYPE html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Home Details</title>
    <link rel="stylesheet" href="~/css/HomeDetails.css" />
    <!-- Make sure you have Bootstrap included -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg- text-dark "> 

    <div class="container my-4">
        <div class="d-flex justify-content-center gap-3 mb-4">
            <form asp-controller="OfferInfoService" asp-action="TheOfferForm" asp-route-HomeID="@Model.HomeID" method="get">
                <button type="submit" class="btn btn-primary">Offer Form</button>
            </form>

            <form asp-controller="ShowingService" asp-action="ShowingRequestPage" asp-route-homeID="@Model.HomeID" method="get">
                <button type="submit" class="btn btn-primary">Schedule Showing</button>
            </form>
        </div>

        <div class="row g-4">
            <!-- About Card -->
            <div class="col-md-4">
                <div class="card bg-light shadow-sm  custom-btn">
                    <div class="card-body">
                        <h5 class="card-title mb-3">About</h5>
                        <p class="mb-1"><strong>Property Type:</strong> @Model.PropType</p>
                        <p class="mb-1"><strong>Price:</strong> $@Model.HomePrice</p>
                        <p class="mb-1"><strong>Address:</strong> @Model.Address, @Model.City, @Model.State, @Model.Zipcode</p>
                    </div>
                </div>
            </div>

            <!-- Room Info Card -->
            <div class="col-md-4">
                <div class="card bg-light shadow-sm custom-btn">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Room Info</h5>
                        @if (Model.Rooms != null && Model.Rooms.Any())
                        {
                            @foreach (var room in Model.Rooms)
                            {
                                <div class="mb-3">
                                    <h6 class="mb-1 text-uppercase">@room.RoomTitle.Replace("_", " ")</h6>
                                    <p class="mb-1"><strong>Width:</strong> @room.RoomWidth</p>
                                    <p class="mb-1"><strong>Length:</strong> @room.RoomLength</p>
                                    <p class="mb-1"><strong>Level:</strong> @room.RoomLevel</p>
                                </div>
                            }
                        }
                        else
                        {
                            <p>No Rooms Available</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Amenities Info Card -->
            <div class="col-md-4">
                <div class="card bg-light shadow-sm custom-btn">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Amenities Info</h5>
                        @if (Model.Amenities != null && Model.Amenities.Any())
                        {
                            @foreach (HomeFacilities amenity in Model.Amenities)
                            {
                                @foreach (var a in amenity.Amenities)
                                {
                                    <p class="mb-1">@a</p>
                                }
                            }
                        }
                        else
                        {
                            <p>No Amenities Available</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Utilities Info Card -->
            <div class="col-md-4">
                <div class="card bg-light shadow-sm custom-btn">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Utilities Info</h5>
                        <p class="mb-1"><strong>Cooling Type:</strong> @Model.Facilities.Cooling</p>
                        <p class="mb-1"><strong>Heating Type:</strong> @Model.Facilities.Heating</p>
                        <p class="mb-1"><strong>Water Type:</strong> @Model.Facilities.WaterType</p>
                        <p class="mb-1"><strong>Sewer Type:</strong> @Model.Facilities.SewerType</p>
                    </div>
                </div>
            </div>

            <!-- Agent Info Card -->
            <div class="col-md-4">
                <div class="card bg-light shadow-sm custom-btn">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Agent Info</h5>
                        <p class="mb-1"><strong>Name:</strong> @Model.TheAgent.FirstName @Model.TheAgent.LastName</p>
                        <p class="mb-1"><strong>Work Email:</strong> @Model.TheAgent.WorkEmail</p>
                        <p class="mb-1"><strong>Work Phone:</strong> @Model.TheAgent.WorkPhoneNum</p>
                        <p class="mb-1"><strong>Work Address:</strong> @Model.TheAgent.WorkAddress, @Model.TheAgent.WorkCity, @Model.TheAgent.WorkState, @Model.TheAgent.WorkZip</p>
             
                    </div>
                </div>
            </div>

            <!-- Company Info Card -->
            <div class="col-md-4 mb-5 bgColor">
                <div class="card bg-light shadow-sm custom-btn bgColor">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Company Info</h5>
                        <h6 class="mb-1">Company Info:</h6>
                        <p class="mb-1"><strong>Company Name:</strong> @Model.TheAgent.CompanyName</p>
                        <p class="mb-1"><strong>Company Email:</strong> @Model.TheAgent.CompanyEmail</p>
                        <p class="mb-1"><strong>Company Phone:</strong> @Model.TheAgent.CompanyPhoneNum</p>
                        <p class="mb-1"><strong>Company Address:</strong> @Model.TheAgent.CompanyAddress, @Model.TheAgent.CompanyCity, @Model.TheAgent.CompanyState, @Model.TheAgent.CompanyZip</p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    
</body>
</html>
