@{
    // ViewData["Title"] = "Home Page";
}
@addTagHelper *,  Microsoft.AspNetCore.Mvc.TagHelpers
@model TermProject.Models.CustomerShowingRequest

<div class="text-center">
    <h1 class="display-4">Home Tour Request</h1>
    
</div>
<!DOCTYPE html>
<html>
<head>
    <style>

        h1 {
            color: orange;
        }

        body {
            background-color: #faf3e0;
        }

        label {
            color: black;
        }
    </style>
</head>
<body>
    <form asp-controller="ShowingService" asp-action="Tour" method="POST">

        <div class="form-group">

            <label class="form-label"> First Name: </label>

            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"> </span>

        </div>
        <br />

        <div class="form-group">

            <label class="form-label"> Last Name: </label>

            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"> </span>

        </div>
        <br />

        <div class="form-group">

            <label class="form-label"> Email: </label>

            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"> </span>

        </div>
        <br />

        <div class="form-group">

            <label class="form-label"> Phone Number: </label>

            <input asp-for="PhoneNum" class="form-control" />
            <span asp-validation-for="PhoneNum" class="text-danger"> </span>

        </div>
        <br />

        <div class="form-group">

            <label class="form-label"> Tour date: </label>

            <input asp-for="ShowDate" type="date" class="form-control" />
            <span asp-validation-for="ShowDate" class="text-danger"> </span>

        </div>
        <br />

        <div class="form-group">
            <label for="time">Select a time:</label>
            <input asp-for="ShowTime" type="time" class="form-control" />
            
        </div>
        <br />

        <div class="d-flex justify-content-center">
            <div class="form-group">
                <a asp-controller="HomeDisplay" asp-action="AllHomes" class="btn btn-primary">Submit Tour</a>
            </div>
        </div>
        <br />

        <div class="container">

            @ViewData["ErrorMessage"]
        </div>
    </form>
</body>
</html>
