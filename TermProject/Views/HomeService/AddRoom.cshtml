@model TermProject.Models.RoomInfo
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

<h1>Rooms Here :)</h1>

<form method="post" asp-action="AddRoom">

    <div>
        <input asp-for=Id type="hidden" name="Id" value="@ViewBag.HomeId" />
    </div>

    <div>
        <label for="roomType">Select Room Type:</label>
        <select id="roomType" asp-for="RoomTitle" class="form-control">
            <option value="">-- Select an Option --</option>
            @foreach (var option in (List<string>)ViewBag.RoomType)
            {
                <option value="@option">@option</option>
            }
        </select>
    </div>

    <div>
        <label asp-for="RoomWidth" class="control-label"></label>
        <input asp-for="RoomWidth" class="form-control" />
        <span asp-validation-for="RoomWidth" class="text-danger"></span>
    </div>

    <!-- Input for RoomLength -->
    <div>
        <label asp-for="RoomLength" class="control-label"></label>
        <input asp-for="RoomLength" class="form-control" />
        <span asp-validation-for="RoomLength" class="text-danger"></span>
    </div>
        
    <div>
        <label asp-for="RoomLevel" class="control-label"></label>
        <input asp-for="RoomLevel" class="form-control" />
        <span asp-validation-for="RoomLevel" class="text-danger"></span>
    </div>

    <div>
        
        <button type="submit">Add Room To Home</button>
    </div>
    
</form>

<form method="get" asp-controller="HomeService" asp-action="AddImages">
    <!-- Add your Home form fields here -->
    <button type="submit" class="btn btn-primary">Finish Adding Rooms</button>
</form>

@{
}
