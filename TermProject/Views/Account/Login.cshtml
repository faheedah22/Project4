@model TermProject.Models.AgentInfo
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Welcome Back!</title>
    <style>
        h1 {
            color: orange;
        }

        body {
            background-color: #faf3e0;
        }

        label {
            color: black;
        }
    </style>
    <!-- Include Bootstrap CSS if not already included -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>

    <div class="text-center my-4">
        <h1 class="display-4">Welcome Back!</h1>
    </div>

    <div class="container">
        <!-- Login Form -->
        <form asp-controller="Account" asp-action="Login" method="POST" class="mb-4">
            <div class="mb-3">
                <label class="form-label">Username:</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Password:</label>
                <input asp-for="UserPassword" class="form-control" type="password" />
                <span asp-validation-for="UserPassword" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-center">
                <button id="btnLogin" type="submit" class="btn btn-warning btn-lg w-100">Login</button>
            </div>
        </form>

        <!-- Back Button -->
        <div class="d-flex justify-content-center mb-4">
            <a asp-controller="Account" asp-action="HomePage" class="btn btn-warning btn-lg w-100">Back</a>
        </div>

        <div>
            @ViewData["ErrorMessage"]
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
