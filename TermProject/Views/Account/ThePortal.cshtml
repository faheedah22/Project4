}
@addTagHelper *,  Microsoft.AspNetCore.Mvc.TagHelpers
@model TermProject.Models.AgentInfo

<!DOCTYPE html>
<html>
<head>

</head>
<body>
    <form asp-controller="HomeDirections" asp-action="HomePage" method="get">

        <div class="d-flex justify-content-center">
            <div class="form-group">
                <button type="submit" class="btn btn-primary">HomePage</button>
@*                 <button id="btnHomePage" name="action" value="homePage" type="submit" class="btn btn-warning btn-block btn-lg">HomePage</button> *@
            </div>
        </div>

        </form>


        <br />
    <form asp-controller="HomeService" asp-action="GetHomeInfo" asp-route-agentID="@Model.AgentID" method="get">
        <div class="d-flex justify-content-center">
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Add Home</button>
       @*          <button id="btnAddHome" name="action" value="addHome" type="submit" class="btn btn-warning btn-block btn-lg">Add Home</button> *@
            </div>
        </div>
        </form>
        <br />

    <form asp-controller="HomeService" asp-action="AgentHomes" asp-route-agentID="@Model.AgentID" method="get">
        <div class="d-flex justify-content-center">
            <div class="form-group">
                <button type="submit" class="btn btn-primary">View Homes</button>
          @*       <button id="btnAllHomes" name="action" value="viewHomes" type="submit" class="btn btn-warning btn-block btn-lg">View Homes</button> *@
            </div>
        </div>
        </form>
        <br />

    <form asp-controller="HomeDirections" asp-action="Tours" asp-route-agentID="@Model.AgentID" method="get">
        <div class="d-flex justify-content-center">
            <div class="form-group">
                <button type="submit" class="btn btn-primary">View Sheduled Tours</button>
@*                 <button id="btnTours" name="action" value="tours" type="submit" class="btn btn-warning btn-block btn-lg">View Scheduled Tours</button>
 *@            </div>
        </div>
        </form>
        <br />

    <form asp-controller="HomeDirections" asp-action="Offers" asp-route-agentID="@Model.AgentID" method="get">
        <div class="d-flex justify-content-center">
            <div class="form-group">
                <button type="submit" class="btn btn-primary">View Offers</button>
@*                 <button id="btnOffers" name="action" value="offers" type="submit" class="btn btn-warning btn-block btn-lg">View Offers</button> *@
            </div>
        </div>


    </form>
</body>
</html>